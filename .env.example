# Mnemonic MCP server configuration.
# Copy this file to `.env` and edit. `.env` is gitignored; `.env.example` is committed.

# ── Identity & storage ────────────────────────────────────────────────────────
# Ed25519 keypair. Auto-created on first run if missing.
MNEMONIC_KEYPAIR_PATH=~/.mnemonic/id.json
# SQLite database path. Schema is created on first run.
DATABASE_PATH=~/.mnemonic/attestations.db
# local  — SQLite-only, no on-chain writes, no funded keypair needed.
# full   — Arweave + Solana + SQLite. Requires a funded keypair.
#
# Since the `modes-user-choice` feature, STORAGE_MODE sets the operator
# *capability/default* (what this deploy CAN serve, and what to apply when a
# client doesn't send the `mode` field) — NOT a global per-call switch.
# Write mode is a per-request user choice via the optional `mode` field on
# `mnemonic_sign_memory` (`"local"` | `"participate"`, default `local`).
# `local` writes are always free regardless of PAYMENT_MODE — the paywall
# fires only on resolved `participate`. See
# `work/modes-user-choice/user-spec.md` for the canonical model.
STORAGE_MODE=local

# ── Embedding provider ────────────────────────────────────────────────────────
# fastembed (default, needs `--features local-embed`), openai, or hash (deprecated).
EMBED_PROVIDER=fastembed
# Required when EMBED_PROVIDER=openai.
# OPENAI_API_KEY=

# ── Compression ───────────────────────────────────────────────────────────────
# TurboQuant bit width: 2, 3, or 4. Do not change for an existing database.
TURBO_BITS=4

# ── On-chain endpoints (full mode only) ───────────────────────────────────────
ARWEAVE_URL=https://uploader.irys.xyz
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Google OAuth (hosted MCP + Chrome extension sign-in, T14/T16) ────────────
# Empty client_id disables the Google OAuth handlers (router skips installation).
# Get these from Google Cloud Console → APIs & Services → Credentials.
# Use type "Web application" — Chrome extension OAuth type requires a Web Store
# Item ID; "Web application" works with chrome.identity.launchWebAuthFlow +
# PKCE via the extension's chromiumapp.org redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match exactly what's whitelisted under "Authorized redirect URIs" in
# the Google Cloud OAuth client. For the production Chrome extension build
# (Web Store ID iegoicpcogbnnnajgfdbljfickgfnfoj):
#   https://iegoicpcogbnnnajgfdbljfickgfnfoj.chromiumapp.org/google
GOOGLE_OAUTH_REDIRECT_URI=
# Server's public origin (used in OAuth metadata + callback redirects).
# MCP_PUBLIC_BASE_URL=https://mcp.mnemonik.xyz
# HS256 secret for OAuth Bearer JWTs. Required in hosted mode. ≥32 random
# bytes: `openssl rand -base64 32`.
# MCP_JWT_SECRET=
# Optional JWT access-token TTL override (seconds). Default: 3600 (1 hour).
# Clamped to [60, 604800] (1 minute – 7 days); out-of-range, empty, or
# unparseable values WARN-log at startup and fall back to the clamp /
# default. Production leaves this unset; `mcp.dev.mnemonik.xyz` sets it
# to 60 for the Task 10 R1 empirical gate (refresh-token-rotation
# Decision 12 — a 2-minute parallel Cursor + Claude.ai observation
# window watching an expiry fire).
# MCP_JWT_TTL_SECS=3600

# ── MCP transport ─────────────────────────────────────────────────────────────
# stdio — for Cursor/Claude Desktop local integration.
# http  — for remote HTTP JSON-RPC.
MCP_TRANSPORT=http
MCP_HTTP_PORT=3000

# ── Payment gating (full/http mode) ───────────────────────────────────────────
# none — no gating. balance — API-key balance. x402 — x402 payment. both — either.
#
# Like STORAGE_MODE, PAYMENT_MODE now sets the operator's *capability/default*
# for how `participate` writes are charged. `local` writes are ALWAYS free
# regardless of PAYMENT_MODE — the paywall gate fires only when the
# resolved write mode is `participate`. See
# `work/modes-user-choice/user-spec.md` and `tech-spec.md` for details.
PAYMENT_MODE=none

# ── Delivery guarantee + DoS guard (modes-user-choice T3) ────────────────────
# A `participate` write is "delivered" only after the anchored bytes pass a
# recall+verify round-trip; on failure the row is demoted to `local` and the
# reserved payment is refunded. The four knobs below tune that flow.
#
# Wall-clock budget (seconds) for the Arweave re-fetch after the Solana memo
# lands. Sized against Arweave's eventual-consistency window; retried with
# exponential backoff until budget exhausted, then row demoted + refund.
MNEMONIC_DELIVERY_REFETCH_TIMEOUT_SECS=15
# Per-billable-subject demotion quota (default: 5 demotions per window).
# Keyed by `blake3(api_key)` (Bearer) or `blake3(tx_sig)` (x402), NOT by
# `owner_pubkey` — Ed25519 keys rotate freely; billable subjects don't.
# Exceeded → `-32011 DeliveryQuotaExceeded`, zero chain spend.
MNEMONIC_DELIVERY_QUOTA_THRESHOLD=5
# Sliding window (seconds) over which the quota counts demotions.
MNEMONIC_DELIVERY_QUOTA_WINDOW_SECS=60
# Background eviction interval (seconds) — drops idle quota entries so the
# map size tracks *active* spenders, not lifetime cardinality.
MNEMONIC_DELIVERY_QUOTA_EVICT_SECS=30

# ── Ollama / RAG (webapp chatbot) ────────────────────────────────────────────
# Ollama API base URL. Only http://localhost:* and http://ollama:* are allowed
# (SSRF prevention). Server refuses to start if set to any other host.
OLLAMA_URL=http://localhost:11434
# Ollama model for chat inference.
OLLAMA_MODEL=qwen2.5:3b
# Directory where RAG artifacts (whitepaper chunks .zip) are written at startup.
RAG_CHUNK_DIR=./rag_chunks

# ── LLM provider (universal chat inference) ─────────────────────────────────
# Supported: ollama, groq, openrouter, together, cerebras, openai, anthropic
LLM_PROVIDER=ollama
# API key (not needed for ollama).
# LLM_API_KEY=
# Model override. Leave empty to use provider default:
#   ollama: qwen2.5:3b, groq: llama-3.1-8b-instant,
#   openrouter: meta-llama/llama-3.1-8b-instruct,
#   together: meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo,
#   cerebras: llama3.1-8b, openai: gpt-4o-mini,
#   anthropic: claude-sonnet-4-20250514
# LLM_MODEL=
# API URL override. If set, used regardless of provider.
# LLM_API_URL=
# Maximum tokens for LLM responses.
LLM_MAX_TOKENS=512
