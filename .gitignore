# Environment variables and secrets (CRITICAL - MUST ignore)
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets/
.secrets/
*api-key*
*apikey*
*secret*

# Local settings (not shared)
.claude/settings.local.json

# Internal launch / go-to-market planning (NOT for public repo)
work/public-launch/

# Workspace working logs (per-feature scratch)
work/*/logs/

# Embedder + retrieval caches
.fastembed_cache/
rag_chunks/

# TypeScript incremental build cache
*.tsbuildinfo

# Dependencies
node_modules/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
.next/
out/

# Rust
target/
**/*.rs.bk

# wasm-pack outputs (regenerated by build scripts)
core/pkg/
core/pkg-*/
packages/sdk/wasm/

# npm pack tarballs (generated by `npm pack` for local install testing)
packages/*/*.tgz

# Bun lockfile — npm is the canonical package manager for the JS workspace;
# bun.lock is per-developer-machine. Revisit if/when CI adopts bun.
bun.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
/logs/

# Test coverage
coverage/
.coverage
htmlcov/

# Playwright artefacts (extension E2E)
test-results/
playwright-report/
playwright/.cache/

# Temporary files
tmp/
temp/
*.tmp

# Local-only AI-dev methodology framework (from github.com/pavel-molyanov/molyanov-ai-dev).
# Installed as tooling so /do-feature and the spec-driven commands/skills/agents work
# in-repo; intentionally NOT committed. The project-specific project-knowledge skill is
# tracked and explicitly kept below.
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/shared/
.claude/skills/*
!.claude/skills/project-knowledge/

# Ruflo runtime + per-developer .claude/ artifacts (per-developer, NOT shared).
# Mirrors the rules previously added on claude/modes-user-choice-Qkk6X but that
# were superseded by the broader .claude/skills/* allowlist in cbe8a7e. These
# directories are runtime/config noise and shouldn't ship.
.claude-flow/
.claude/helpers/
.claude/settings.json
.mcp.json
PROJECT_MEMORY.md
