# Environment variables and secrets (CRITICAL - MUST ignore)
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets/
.secrets/
*api-key*
*apikey*
*secret*

# Local settings (not shared)
.claude/settings.local.json

# Dependencies
node_modules/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
.next/
out/

# Rust
target/
**/*.rs.bk

# wasm-pack outputs (regenerated by build scripts)
core/pkg/
core/pkg-*/
packages/sdk/wasm/

# npm pack tarballs (generated by `npm pack` for local install testing)
packages/*/*.tgz

# Bun lockfile — npm is the canonical package manager for the JS workspace;
# bun.lock is per-developer-machine. Revisit if/when CI adopts bun.
bun.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
/logs/

# Test coverage
coverage/
.coverage
htmlcov/

# Temporary files
tmp/
temp/
*.tmp
