# ---------------------------------------------------------------------------
# Mnemonic MCP — docker-compose environment file.
#
# Copy to `mcp.env` next to docker-compose.yml on the VPS, fill the secrets,
# then:  docker compose --env-file mcp.env up -d
#
# This ONE file is used two ways:
#   1. `--env-file mcp.env` → ${...} interpolation in docker-compose.yml
#      and COMPOSE_PROFILES selection (co-located vs split Ollama).
#   2. `env_file:` on the mcp service → every var below is also exported into
#      the mcp container, so the server reads STORAGE_MODE, MCP_JWT_SECRET, etc.
#
# Anything already set on a running host stays as-is — only fill what's blank.
# ---------------------------------------------------------------------------

# ===== Topology =============================================================
# Co-located (default): run Ollama in this stack. For a split deploy where
# Ollama lives on another host, set COMPOSE_PROFILES= (empty) and point
# OLLAMA_URL at the remote instance.
COMPOSE_PROFILES=ollama
OLLAMA_URL=http://ollama:11434

# Host bind for the MCP port. Loopback = only this host's nginx can reach it.
# Set to 0.0.0.0 (and firewall :3000 to the proxy host) if a REMOTE nginx
# fronts this MCP box.
MCP_BIND=127.0.0.1
MCP_PORT=3000

# ===== Images ===============================================================
# CI builds and pushes ghcr.io/mnemonik-xyz/mnemonic-mcp. Pin a tag for prod
# (e.g. v0.2.8) instead of `latest` so redeploys are reproducible.
MCP_IMAGE=ghcr.io/mnemonik-xyz/mnemonic-mcp
MCP_IMAGE_TAG=latest
OLLAMA_IMAGE=monorepo-ollama

# ===== TLS / domain (nginx + certbot) =======================================
DOMAIN=mnemonik.xyz
CERTBOT_EMAIL=bogdan.sivochkin@gmail.com

# ===== MCP server runtime (passed into the container) =======================
STORAGE_MODE=local
EMBED_PROVIDER=fastembed
TURBO_BITS=4
PAYMENT_MODE=none
OLLAMA_MODEL=qwen2.5:1.5b
RUST_LOG=info

# Public origin advertised in OAuth metadata + embedded in challenge envelopes.
# MUST match the domain external MCP clients connect to (Cursor/Claude.ai
# enforce RFC 8707 origin check). No trailing slash.
MCP_PUBLIC_BASE_URL=https://mcp.mnemonik.xyz

# ===== Hosted-mode secrets (REQUIRED in hosted/OAuth mode) ==================
# Generate ONCE per deploy and keep stable across redeploys:
#   openssl rand -base64 32
# Rotating MCP_REFRESH_SALT invalidates every live refresh token (at-rest hash
# changes) — treat as a deliberate operational event, not a routine deploy.
MCP_JWT_SECRET=
MCP_REFRESH_SALT=
# Optional access-token TTL override (default 3600s). Leave blank in prod.
# MCP_JWT_TTL_SECS=

# ===== Google OAuth (Chrome extension sign-in) — optional ===================
# Empty GOOGLE_OAUTH_CLIENT_ID disables the Google OAuth router entirely.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ===== Chain-backed traction stats ==========================================
# Managed by the Deploy MCP workflow (upserted on every deploy) — no need to
# fill these by hand. Public data only: base58 addresses of the wallet(s)
# that signed anchored uploads. Empty = feature off, DB-only stats.
# The Solana RPC must be a real mainnet endpoint (memo-history enumeration);
# the workflow adds the public default only if this line is absent, so a
# custom RPC set here survives deploys.
# CHAIN_STATS_WALLETS=DYVu4Bry3BzGVsR3Hj2iGVT5fNdWFoHw2zRxsdTmrG25
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Optional =============================================================
# Best-effort webhook pinged after a blog publish to rebuild the static webapp.
# BLOG_REBUILD_HOOK=
