{
  "name": "@mnemonik-xyz/mcp",
  "version": "0.2.0",
  "description": "MCP shim for Mnemonic Protocol. Downloads + verifies the matching mnemonik-mcp Rust binary from GitHub Releases on first invocation; provides install/install --check/mcp-stdio/doctor subcommands. No postinstall script — lazy install on first run. See Decisions 8/9 in work/agent-native-distribution/tech-spec.md.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "bin": {
    "mnemonik-mcp": "./dist/bin/mnemonik-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnemonik-xyz/monorepo.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/mnemonik-xyz/monorepo#readme",
  "bugs": "https://github.com/mnemonik-xyz/monorepo/issues",
  "keywords": [
    "mnemonic",
    "mcp",
    "ai",
    "memory",
    "shim"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "tar": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
