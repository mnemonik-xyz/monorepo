{
  "name": "@mnemonik-xyz/cli",
  "version": "0.1.7",
  "description": "Command-line interface for the Mnemonic Protocol. Thin wrapper around @mnemonik-xyz/sdk that adds Node-only persistence (~/.mnemonic/), interactive OAuth loopback, and TTY-aware output formatting.",
  "license": "Apache-2.0",
  "//": "private: false — npm publish-ready (T14). Scoped package, public access set explicitly.",
  "private": false,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "mnemonic": "./dist/bin/mnemonic.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnemonik-xyz/monorepo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mnemonik-xyz/monorepo#readme",
  "bugs": "https://github.com/mnemonik-xyz/monorepo/issues",
  "keywords": [
    "mnemonic",
    "mcp",
    "ai",
    "memory",
    "ed25519",
    "cose",
    "cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@mnemonik-xyz/sdk": "^0.1.5",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/curves": "^1.4.0",
    "bs58": "^6.0.0",
    "commander": "^14.0.3",
    "kleur": "^4.1.5",
    "open": "^11.0.0",
    "qrcode-terminal": "^0.12.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/qrcode-terminal": "^0.12.2",
    "execa": "^9.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
